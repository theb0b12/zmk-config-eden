#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/36.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2 // thumb keys

/ {
    behaviors {
        /* Left-hand HRMs. */

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS 16 17 9 1 2 10 18 24 25 26 12 19 4 11 3 27 28 29>;
            hold-trigger-on-release;
        };

        /* Right-hand HRMs. */

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS 27 26 25 24 28 29 23 22 21 20 8 0 13 5 6 15 7 14>;
            hold-trigger-on-release;
        };

        sh: sticky_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "SH";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        par1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 2>;
            layers = <0>;
        };

        par2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 5>;
            layers = <0>;
        };

        cur1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <18 19>;
            layers = <0>;
        };

        cur2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <21 20>;
            layers = <0>;
        };

        bracket1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 10>;
            layers = <0>;
        };

        bracket2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <13 14>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            layers = <0>;
        };

        quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <23 15>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <15 13 14>;
            layers = <0>;
        };

        lower {
            bindings = <&mo 1>;
            key-positions = <20 21 22>;
            layers = <0>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <11 10 9>;
            layers = <0>;
        };

        alt {
            bindings = <&kp LALT>;
            key-positions = <19 18 17>;
            layers = <0>;
        };

        // alpha keys

        q {
            bindings = <&kp Q>;
            key-positions = <16 9>;
            layers = <0>;
        };

        z {
            bindings = <&kp Z>;
            key-positions = <17 18>;
            layers = <0>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <12 4>;
            layers = <0>;
        };

        y {
            bindings = <&kp Y>;
            key-positions = <0 8>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <22 21>;
            layers = <0>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <7 6>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty-base {
            bindings = <
&kp H  &kp W                &kp E     &kp R        &kp T                &kp U      &kp I      &kp O
&kp N  &hml LEFT_CONTROL S  &kp D     &kp F        &kp G                &kp J      &kp K      &hmr RCTRL L
&kp A  &kp X                &kp C     &kp V                             &kp M      &kp COMMA  &kp DOT       &kp P
                            &kp LGUI  &lt 1 ENTER  &kp BSPC  &kp SPACE  &kp LSHFT  &sh 3 2
            >;
        };

        num {
            bindings = <
&trans   &trans  &trans  &trans        &trans           &kp N7  &kp N8  &kp N9
&trans   &trans  &trans  &kp LEFT_ALT  &trans           &kp N4  &kp N5  &kp N6
&kp TAB  &trans  &trans  &trans                         &kp N1  &kp N2  &kp N3  &kp N0
                 &trans  &trans        &trans  &kp DEL  &trans  &trans
            >;
        };

        upper {
            bindings = <
&kp MINUS        &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT          &kp CARET  &kp AMPERSAND  &kp ASTERISK
&kp UNDERSCORE   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR           &kp EQUAL  &kp BSLH       &kp GRAVE
&kp EXCLAMATION  &trans        &trans        &trans                             &kp PLUS   &kp PIPE       &kp TILDE     &trans
                               &trans        &trans        &trans       &trans  &trans     &trans
            >;
        };

        fn-nav-bootloader {
            bindings = <
&trans       &kp F2   &kp F3   &kp F4   &kp F5               &trans    &trans    &trans
&bootloader  &kp F10  &kp F11  &kp F12  &bootloader          &trans    &kp UP    &trans
&kp F1       &trans   &trans   &trans                        &kp LEFT  &kp DOWN  &kp RIGHT  &trans
                      &trans   &trans   &trans       &trans  &trans    &trans
            >;
        };
    };
};
